@backend_HostAddress = http://localhost:5044
@apiKey = replace-with-gemini-api-key

GET {{backend_HostAddress}}/api/health
Accept: application/json

###

GET {{backend_HostAddress}}/api/health/database
Accept: application/json

###

GET {{backend_HostAddress}}/api/food-items/search?q=appl
Accept: application/json

###

GET {{backend_HostAddress}}/api/purchases/summary
Accept: application/json

###

GET {{backend_HostAddress}}/api/purchases/summary?fromDate=2026-01-01&toDate=2026-01-31
Accept: application/json

###

GET {{backend_HostAddress}}/api/tags
Accept: application/json

### Replace all tags for a food item
PUT {{backend_HostAddress}}/api/food-items/1/tags
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
	"tags": ["Drinks", "Pop"]
}

###

POST {{backend_HostAddress}}/api/auth/verify-key
X-Api-Key: {{apiKey}}
